{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...path].mjs": {
      "includeFiles": "{data/store.json,public/index.html}"
    }
  },
  "redirects": [
    {
      "source": "/pwa",
      "destination": "/pwa/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pwa/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/pwa/",
      "destination": "/api/pwa-view"
    },
    {
      "source": "/pwa/index.html",
      "destination": "/api/pwa-view"
    },
    {
      "source": "/pwa/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/pwa/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/pwa/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ]
}
